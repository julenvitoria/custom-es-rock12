From e323c5c212e73f3b77b54a6b66681411f5ac160a Mon Sep 17 00:00:00 2001
From: julenvitoria <julenvitoria@hotmail.es>
Date: Thu, 26 Nov 2026 09:45:21 +0100
Subject: [PATCH] bq24072: pull up the /PG and /CHG inputs

Both are open-drain BQ24072 outputs configured with no pull. With USB
out, /CHG was seen reading low now and then (empty battery icon in the
menu header and pause menu while a ScummVM game was being copied to
flash, and again later in the pause menu): get_state() then reports
"battery missing", and a latch taken at that moment is mapped with the
charge tables, giving a lower level that anti-rise then keeps.

Enable the internal pull-ups so both pins stay defined. The pins are
still de-initialised for STOP2, so sleep current is unchanged.
---
 Core/Src/bq24072.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/Core/Src/bq24072.c b/Core/Src/bq24072.c
index 18b7462..4bba78d 100644
--- a/Core/Src/bq24072.c
+++ b/Core/Src/bq24072.c
@@ -504,14 +504,23 @@ void bq24072_interrupts_enable(void)
 {
     GPIO_InitTypeDef GPIO_InitStruct = {0};
 
+    /*
+     * /PG and /CHG are open-drain outputs of the BQ24072. With no pull they
+     * can float when nothing drives them: with USB out, /CHG was seen
+     * reading low now and then, giving the "battery missing" state (empty
+     * HUD icon) and mapping latches with the charge tables (lower level,
+     * then pinned by anti-rise). The weak internal pull-ups keep both
+     * defined and are harmless next to an external one. They are released
+     * in STOP2 (bq24072_interrupts_disable de-inits both pins).
+     */
     GPIO_InitStruct.Pin = GPIO_CHARGER_POWERGOOD_Pin;
     GPIO_InitStruct.Mode = GPIO_MODE_IT_RISING_FALLING;
-    GPIO_InitStruct.Pull = GPIO_NOPULL;
+    GPIO_InitStruct.Pull = GPIO_PULLUP;
     HAL_GPIO_Init(GPIO_CHARGER_POWERGOOD_GPIO_Port, &GPIO_InitStruct);
 
     GPIO_InitStruct.Pin = GPIO_CHARGER_CHARGING_Pin;
     GPIO_InitStruct.Mode = GPIO_MODE_IT_RISING_FALLING;
-    GPIO_InitStruct.Pull = GPIO_NOPULL;
+    GPIO_InitStruct.Pull = GPIO_PULLUP;
     HAL_GPIO_Init(GPIO_CHARGER_CHARGING_GPIO_Port, &GPIO_InitStruct);
 
     HAL_NVIC_SetPriority(GPIO_CHARGER_POWERGOOD_EXTI_IRQn, 0, 0);
-- 
