diff --git a/Core/Inc/gw_lcd.h b/Core/Inc/gw_lcd.h
index 65e27da..e136b11 100644
--- a/Core/Inc/gw_lcd.h
+++ b/Core/Inc/gw_lcd.h
@@ -184,6 +184,12 @@ int lcd_overlay_clut_end_will_restore(void);
  * Use after pause exit (buffers already cleared). */
 void lcd_overlay_clut_end_all(void);
 
+/* For chrome drawn outside a begin()/end() pair (progress bars a core asks
+ * for while its 256-colour CLUT is loaded): stamp the overlay colours now and
+ * keep them until the frame after this one is swapped in, or until the core
+ * loads a CLUT. Safe to call on every redraw. No-op outside LUT8. */
+void lcd_overlay_clut_hold(void);
+
 /* Sum of R+G+B for a CLUT index (0..765). Overlay / out-of-range → 0.
  * Used by the in-game HUD to treat near-black game pixels like letterbox
  * (stamp solid gray — darken alone stays invisible on black). */
diff --git a/Core/Src/gw_lcd.c b/Core/Src/gw_lcd.c
index 6fdc59d..a41dfac 100644
--- a/Core/Src/gw_lcd.c
+++ b/Core/Src/gw_lcd.c
@@ -243,8 +243,16 @@ uint32_t lcd_get_pixel_position()
   return (uint32_t)(hltdc.Instance->CPSR);
 }
 
+/* lcd_overlay_clut_hold(): swaps left before the overlay CLUT is released. */
+static uint8_t overlay_clut_hold_swaps = 0;
+
 void lcd_swap(void)
 {
+  /* Release a lcd_overlay_clut_hold() once its chrome is no longer the frame
+   * being shown: the cart CLUT is restored together with this swap. */
+  if (overlay_clut_hold_swaps != 0 && --overlay_clut_hold_swaps == 0)
+    lcd_overlay_clut_end();
+
   /* Program the just-drawn buffer into the shadow CFBAR, then reload at
    * vblank. An IMR reload here would apply a few lines into the next
    * frame (horizontal bar at the top of the panel); VBR applies at the
@@ -685,6 +693,7 @@ void lcd_set_clut(const uint32_t *clut, uint16_t count)
   active_clut_count = count;
   overlay_clut_live = 0;
   overlay_clut_depth = 0;
+  overlay_clut_hold_swaps = 0;
 
   /* Cache cart colours under the overlay window for begin()/end(). */
   clut_cache_cart_under_overlay();
@@ -875,10 +884,21 @@ int lcd_overlay_clut_end(void)
   return 1;
 }
 
+void lcd_overlay_clut_hold(void)
+{
+  if (current_lcd_mode != LCD_MODE_LUT8 || overlay_clut_count == 0)
+    return;
+  if (overlay_clut_hold_swaps == 0)
+    lcd_overlay_clut_begin();
+  /* Survive the swap that shows this chrome; released by the one after. */
+  overlay_clut_hold_swaps = 2;
+}
+
 void lcd_overlay_clut_end_all(void)
 {
   if (current_lcd_mode != LCD_MODE_LUT8)
     return;
+  overlay_clut_hold_swaps = 0;
   if (overlay_clut_depth == 0 && !overlay_clut_live)
     return;
   if (overlay_clut_live && overlay_collides_with_cart()) {
diff --git a/Core/Src/porting/odroid_overlay.c b/Core/Src/porting/odroid_overlay.c
