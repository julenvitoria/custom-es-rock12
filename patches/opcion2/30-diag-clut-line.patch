+/* TEMPORARY DIAGNOSTIC (custom test build only): one-line summary of the
+ * LUT8 CLUT state as seen when packing rgb565. */
+void lcd_debug_clut_line(char *buf, size_t n, uint16_t rgb565)
+{
+  uint16_t idx = lcd_pack_color(rgb565);
+  snprintf(buf, n, "P%d V%d N%u S%d T%d I%u %06lX",
+           lcd_get_mode() == LCD_MODE_LUT8, overlay_clut_live,
+           (unsigned)overlay_clut_count, clut_cart_span(), clut_hw_total(),
+           (unsigned)idx, (unsigned long)(active_clut[idx & 0xFF] & 0xFFFFFFu));
+}
